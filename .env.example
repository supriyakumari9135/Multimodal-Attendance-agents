# Multimodal Attendance & Engagement Agent - Environment Configuration

# Backend
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./data/attendance_agent.db
MEDIA_STORAGE_DIR=./data/uploads
REPORTS_STORAGE_DIR=./data/reports
MODELS_DIR=./models
LOG_LEVEL=INFO

# Privacy & Retention
AUTO_DELETE_RAW_MEDIA=true
MEDIA_RETENTION_HOURS=24
ENABLE_AUDIT_LOGGING=true

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_APP_NAME="Multimodal Attendance & Engagement Agent"
NEXT_PUBLIC_OFFLINE_MODE=true
